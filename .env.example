# Discord bot runtime
BOT_TOKEN=replace_with_discord_bot_token
WELCOME_CHANNEL_ID=replace_with_discord_channel_id
DISCORD_INVITE_URL=https://discord.gg/YJ5B2YRRP

# Optional comma-separated scope. Leave empty to allow every guild/channel where the bot is installed.
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_AGENT_CHANNEL_IDS=
DISCORD_ALLOW_DMS=false

# Guarded OpenAI agent
OPENAI_API_KEY=replace_with_openai_project_key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_AGENT_TRACING=false
AGENT_COOLDOWN_MS=5000
AGENT_MAX_INPUT_CHARS=1500

# Read-only Solana validation
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta

# Public contact text or URL only; availability and pricing always require human review.
VALIDATOR_LEASE_CONTACT=replace_with_public_lease_contact

# GitLab OAuth helper
GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=replace_with_gitlab_client_id
GITLAB_REDIRECT_URI=https://example.com/oauth/gitlab/callback

# Read-only operations display values
GAS_NETWORK=base
PUBLIC_TREASURY_ADDRESS=replace_with_public_watch_address_only
SKYGRID_STATUS_URL=https://skygrid-protocol.net/api/status
